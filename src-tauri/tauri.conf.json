{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fortuna 幸运转盘",
  "version": "0.1.0",
  "identifier": "com.phpgoc.fortuna",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fortuna · 幸运转盘",
        "width": 1500,
        "height": 920,
        "minWidth": 960,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

