{
  "name": "spinning-prize-wheel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:caimi": "vite --mode caimi",
    "build": "bun run scripts/build-web.ts standard",
    "build:windows": "bun run scripts/build-windows.ts",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src",
    "test:e2e": "bun run test:e2e:web && bun run test:e2e:tauri",
    "test:e2e:web": "playwright test --config playwright.config.ts",
    "test:e2e:tauri": "bun run scripts/test-tauri-e2e.ts",
    "test:e2e:headed": "playwright test --headed",
    "tauri:dev": "tauri dev",
    "tauri:dev:caimi": "tauri dev --config src-tauri/tauri.caimi.conf.json",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.0",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  }
}
